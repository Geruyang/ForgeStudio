{
  "name": "@forgedesk/desktop",
  "version": "1.3.0",
  "private": true,
  "description": "ForgeDesk Windows 桌面客户端（Electron + React）",
  "author": "ForgeDesk",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "test": "vitest run --root .",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@forgedesk/contracts": "0.1.0",
    "@forgedesk/engine-adapter": "0.1.0",
    "@forgedesk/engineering-mcp": "0.1.0",
    "@forgedesk/engineering-runner": "0.1.0",
    "diff": "9.0.0",
    "electron-updater": "^6.8.9",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
